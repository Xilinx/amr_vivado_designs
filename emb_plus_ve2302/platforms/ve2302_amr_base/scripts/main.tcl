# Set project variables
set proj_dir ./project
set bd_tcl_dir ./scripts
set dfx_dir ./dfx
set ip_dir_list [list ../ip]
set output_dir ./xsa
set output {xsa}
set static_xdc_list [list ./xdc/pcie.xdc ]
set pblock_xdc_list [list ./xdc/pblock.xdc]
set power_xdc_list [list ./xdc/impl.xdc]
set part xcve2302-sfva784-2MP-e-S
set proj_name ve2302_amr_base
set proj_board [get_board_parts "*:emb-plus-vpr-4616:*" -latest_file_version]
set jobs 8
set verify_board RAVE
set board ve2302
set quick 0

# Load in the variants and their helper functions
source $dfx_dir/board_test/bd/variants.tcl

set variant_list [dict keys $variant_cfg]
set variant [lindex $variant_list 0]

# parse arguments
for { set i 0 } { $i < $argc } { incr i } {
  # jobs
    if { [lindex $argv $i] eq "-jobs" } {
    incr i
    set jobs [lindex $argv $i]
  }
  # quick (Use 0 for full build, 1 for quick build)
    if { [lindex $argv $i] eq "-quick" } {
    incr i
    set quick [lindex $argv $i]
  }
}

puts "Building project '$proj_name' on board '$board'"

if { $quick } {
  puts "Quick mode enabled - just building bram_gpio DFX and skipping board_test"
}

create_project -name $proj_name -force -dir $proj_dir -part $part
set_property board_part $proj_board [current_project]

# set up IP repo
set_property ip_repo_paths $ip_dir_list [current_fileset]
update_ip_catalog -rebuild

add_files -fileset constrs_1 $static_xdc_list

set_property used_in_synthesis false          [get_files *.xdc]

# Set the filename and full path to the memory initialization file and map files generated by config_bd.tcl.
file mkdir "${proj_dir}/generated"

source $bd_tcl_dir/verify_helper.tcl
# Already sourced variants.tcl above, so we can get the variant parameters in these files

# Create the mem and map files for each variant in the design
foreach variant [dict keys $variant_cfg] {

  set design_name "DFX_RP_board_test_${variant}"

  set mem_file [file normalize "${proj_dir}/generated/verify_${variant}.mem"]
  set map_file [file normalize "${proj_dir}/generated/verify_map_${variant}.txt"]

  dict set verify_files $variant mem_file $mem_file
  dict set verify_files $variant map_file $map_file

  source $dfx_dir/board_test/bd/DFX_RP_board_test.tcl

}

source $dfx_dir/bram_gpio/bd/DFX_RP_bram_gpio.tcl
source $bd_tcl_dir/config_bd.tcl

save_bd_design

make_wrapper -files [get_files $proj_dir/$proj_name.srcs/sources_1/bd/$proj_name/$proj_name.bd] -top

add_files -norecurse $proj_dir/$proj_name.gen/sources_1/bd/$proj_name/hdl/${proj_name}_wrapper.v

update_compile_order
set_property top ${proj_name}_wrapper [current_fileset]
update_compile_order -fileset sources_1

save_bd_design
validate_bd_design

source ./${bd_tcl_dir}/make_dfx.tcl

exit
